{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "framework": "other",
  "env": {
    "DATABASE_URL": "@database_url",
    "JWT_SECRET": "@jwt_secret",
    "ADMIN_PASSWORD": "@admin_password"
  },
  "functions": {
    "server/_core/index.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
